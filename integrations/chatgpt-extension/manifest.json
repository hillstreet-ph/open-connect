{
  "manifest_version": 3,
  "name": "Open-Connect for ChatGPT",
  "version": "0.2.0",
  "description": "Open-Connect navigation and optional prompt suggestions for ChatGPT.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://open-connect.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}