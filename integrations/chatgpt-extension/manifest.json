{
  "manifest_version": 3,
  "name": "Open-Connect for ChatGPT",
  "version": "0.2.0",
  "description": "Opt-in Open-Connect companion sidebar and command suggestions",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open-Connect"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}