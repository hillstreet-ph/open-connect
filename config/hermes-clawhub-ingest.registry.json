{
  "schema_version": "1.0.0",
  "registry_id": "open-connect-hermes-clawhub-ingest",
  "requested_at": "2026-11-10",
  "source_catalogs": [
    "https://hermes-agent.nousresearch.com/marketplace (1,484 plugins; first ingest batch: featured and page-one listings)",
    "https://clawhub.ai/plugins (approximately 2,600 plugins; first ingest batch: top-listed plugins)"
  ],
  "ingestion": {
    "mode": "metadata_only",
    "scope_note": "First batch covers the featured, official, and top-listed entries visible in the public catalogs. Remaining catalog pages are ingested in subsequent batches using the same schema; ClawHub API endpoints block automated reads, so full-catalog ingestion requires operator-side clawhub CLI export or manual review.",
    "deduplicated_against": [
      "openclaw/duckduckgo-plugin (already registered)",
      "openclaw/parallel-plugin (already registered)",
      "martian-engineering/lossless-claw (already registered; lossless-context-management recorded for merge review)"
    ]
  },
  "policy": {
    "mode": "metadata_only",
    "install_commands_executed_by_ci": false,
    "auto_install": false,
    "auto_publish": false,
    "executable": false,
    "require_license": true,
    "require_security_review": true,
    "allowed_states": [
      "review_required",
      "approved",
      "rejected"
    ],
    "rationale": "Hermes marketplace and ClawHub resources are cataloged as metadata-only entries. Open-Connect never downloads, executes, or auto-installs registry packages; each entry requires license verification and a separate security review before it can become installable, and installation is operator-run on the target Hermes or OpenClaw host."
  },
  "resolution": {
    "hermes_marketplace": "Unqualified plugin name resolves from https://hermes-agent.nousresearch.com/marketplace at review time; publisher shown on the plugin page.",
    "clawhub_registry": "owner/name resolves to https://clawhub.ai/<owner>/plugins/<name>."
  },
