{
  "id": "open-connect-global-browser",
  "version": "1.0.0",
  "scope": "owner-isolated-all-browser-clients",
  "skill": "skills/open-connect-global-browser/SKILL.md",
  "functions": [
    "browser_automation_status",
    "browser_automation_configure",
    "browser_verification_start",
    "browser_verification_result"
  ],
  "native_tools": [
    "cloud_browser_run",
    "cloud_browser_get_run",
    "cloud_browser_cancel_run",
    "cloud_browser_profiles",
    "browser_provider_start",
    "browser_provider_read",
    "browser_provider_stop"
  ],
  "external_resolver": "two_captcha",
  "supported_external_challenges": ["recaptcha_v2", "turnstile"],
  "policy": {
    "credential_transport": "owned-vault-only",
    "same_browser_reference_required": true,
    "same_origin_required": true,
    "duplicate_paid_submissions_forbidden": true,
    "website_acceptance_requires_verification": true
  },
  "sources": [
    "https://browser-use.com/captcha-solving",
    "https://2captcha.com/api-docs/create-task",
    "https://2captcha.com/api-docs/get-task-result",
    "https://2captcha.com/api-docs/recaptcha-v2",
    "https://2captcha.com/api-docs/cloudflare-turnstile"
  ]
}
