{
  "version": 1,
  "bindings": {
    "OPENAI_API_KEY": "credential://openai/project-agent",
    "GH_TOKEN": "credential://github/app-installation",
    "GITHUB_TOKEN": "credential://github/app-installation",
    "DOCKERHUB_TOKEN": "credential://dockerhub/hillstreet",
    "DOCKER_TOKEN": "credential://dockerhub/hillstreet",
    "CLOUDFLARE_API_TOKEN": "credential://cloudflare/open-connect",
    "ZEABUR_TOKEN": "credential://zeabur/open-connect",
    "SENTRY_AUTH_TOKEN": "credential://sentry/hillstreet",
    "SUPABASE_SECRET_KEY": "credential://supabase/open-connect/service-role",
    "SUPABASE_SERVICE_ROLE_KEY": "credential://supabase/open-connect/service-role",
    "OPEN_CONNECT_API_KEY": "credential://open-connect/mcp",
    "OPENROUTER_API_KEY": "credential://openrouter/model-gateway",
    "REDIS_URL": "credential://redis/open-connect",
    "COMPOSIO_API_KEY": "credential://composio/open-connect",
    "MULTION_API_KEY": "credential://multion/browser-agent",
    "TINYFISH_API_KEY": "credential://tinyfish/browser-agent",
    "TELEGRAM_BOT_TOKEN": "credential://telegram/open-operations-bot"
  },
  "commandProfiles": {
    "gh": "github-release",
    "docker": "docker-release",
    "wrangler": "cloudflare-deploy",
    "supabase": "supabase-admin",
    "zeabur": "zeabur-deploy",
    "sentry-cli": "sentry-release"
  },
  "profiles": {
    "openai-agent": {
      "description": "Create and run the reusable OpenAI agent.",
      "required": ["OPENAI_API_KEY"],
      "optional": [
        "OPENAI_PROJECT_ID",
        "OPENAI_API_BASE",
        "OPENAI_AGENT_STATE_DIR",
        "OPENAI_CAMPAIGN_MODEL",
        "OPENAI_IMAGE_MODEL"
      ]
    },
    "github-release": {
      "description": "Push release branches and operate GitHub Actions.",
      "requiredAny": [["GH_TOKEN", "GITHUB_TOKEN"]],
      "optional": ["OPEN_CONNECT_GITHUB_APP_ID", "OPEN_CONNECT_GITHUB_APP_PRIVATE_KEY"]
    },
    "docker-release": {
      "description": "Build, publish, and verify images in the HillStreet namespace.",
      "requiredAny": [["DOCKERHUB_TOKEN", "DOCKER_TOKEN"]],
      "optional": ["DOCKERHUB_USERNAME"]
    },
    "cloudflare-deploy": {
      "description": "Deploy the Open-Connect edge application.",
      "required": ["CLOUDFLARE_API_TOKEN"],
      "optional": ["CLOUDFLARE_ACCOUNT_ID"]
    },
    "supabase-admin": {
      "description": "Run scoped Open-Connect Supabase administration.",
      "requiredAny": [["SUPABASE_SECRET_KEY", "SUPABASE_SERVICE_ROLE_KEY"]],
      "optional": ["SUPABASE_URL", "SUPABASE_PROJECT_REF"]
    },
    "zeabur-deploy": {
      "description": "Deploy and inspect the Open-Connect Zeabur service.",
      "required": ["ZEABUR_TOKEN"],
      "optional": ["ZEABUR_PROJECT_ID", "ZEABUR_SERVICE_ID"]
    },
    "sentry-release": {
      "description": "Publish and verify an Open-Connect Sentry release.",
      "required": ["SENTRY_AUTH_TOKEN"],
      "optional": ["SENTRY_DSN", "SENTRY_ORG", "SENTRY_PROJECT"]
    },
    "open-connect-plugin": {
      "description": "Authenticate the Codex/ChatGPT Open-Connect MCP plugin.",
      "required": ["OPEN_CONNECT_API_KEY"],
      "optional": ["OPEN_CONNECT_BASE_URL"]
    },
    "model-gateway": {
      "description": "Route application models through the shared OpenRouter gateway.",
      "required": ["OPENROUTER_API_KEY"],
      "optional": ["OPENROUTER_BASE_URL", "LITELLM_BASE_URL"]
    },
    "agent-memory": {
      "description": "Connect agents to shared Redis-backed working memory.",
      "required": ["REDIS_URL"],
      "optional": ["REDIS_AGENT_MEMORY_ENDPOINT", "REDIS_AGENT_MEMORY_STORE_ID"]
    },
    "connector-automation": {
      "description": "Use approved Composio connectors through Open-Connect.",
      "required": ["COMPOSIO_API_KEY"],
      "optional": ["COMPOSIO_BASE_URL"]
    },
    "browser-automation": {
      "description": "Use the approved isolated MultiOn browser adapter.",
      "required": ["MULTION_API_KEY"],
      "optional": ["MULTION_BASE_URL"]
    },
    "tinyfish-browser": {
      "description": "Use the approved TinyFish-compatible cloud browser agent.",
      "required": ["TINYFISH_API_KEY"],
      "optional": ["TINYFISH_BASE_URL"]
    },
    "telegram-operations": {
      "description": "Run approved Open-Operations Telegram bot tasks.",
      "required": ["TELEGRAM_BOT_TOKEN"],
      "optional": ["TELEGRAM_API_ID", "TELEGRAM_API_HASH"]
    },
    "production-deploy": {
      "description": "Release Open-Connect through GitHub, Docker Hub, Cloudflare, Zeabur, and Sentry.",
      "requiredAny": [
        ["GH_TOKEN", "GITHUB_TOKEN"],
        ["DOCKERHUB_TOKEN", "DOCKER_TOKEN"],
        ["CLOUDFLARE_API_TOKEN"],
        ["ZEABUR_TOKEN"],
        ["SENTRY_AUTH_TOKEN"]
      ],
      "optional": [
        "DOCKERHUB_USERNAME",
        "CLOUDFLARE_ACCOUNT_ID",
        "SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    }
  }
}
