{
  "version": 1,
  "profiles": {
    "openai-agent": {
      "description": "Create and run the reusable OpenAI agent.",
      "required": ["OPENAI_API_KEY"],
      "optional": [
        "OPENAI_PROJECT_ID",
        "OPENAI_API_BASE",
        "OPENAI_AGENT_STATE_DIR",
        "OPENAI_CAMPAIGN_MODEL",
        "OPENAI_IMAGE_MODEL"
      ]
    },
    "github-release": {
      "description": "Push release branches and operate GitHub Actions.",
      "requiredAny": [["GH_TOKEN", "GITHUB_TOKEN"]],
      "optional": ["OPEN_CONNECT_GITHUB_APP_ID", "OPEN_CONNECT_GITHUB_APP_PRIVATE_KEY"]
    },
    "open-connect-plugin": {
      "description": "Authenticate the Codex/ChatGPT Open-Connect MCP plugin.",
      "required": ["OPEN_CONNECT_API_KEY"],
      "optional": ["OPEN_CONNECT_BASE_URL"]
    },
    "production-deploy": {
      "description": "Release Open-Connect through GitHub, Docker Hub, Cloudflare, Zeabur, and Sentry.",
      "requiredAny": [
        ["GH_TOKEN", "GITHUB_TOKEN"],
        ["DOCKERHUB_TOKEN", "DOCKER_TOKEN"],
        ["CLOUDFLARE_API_TOKEN"],
        ["ZEABUR_TOKEN"],
        ["SENTRY_AUTH_TOKEN"]
      ],
      "optional": [
        "DOCKERHUB_USERNAME",
        "CLOUDFLARE_ACCOUNT_ID",
        "SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    }
  }
}
