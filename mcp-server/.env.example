# Open-Connect MCP Server Configuration
# Copy this file to .env and fill in your values

# Composio API Key
# Get this from your Composio dashboard at https://composio.dev
COMPOSIO_API_KEY=your_composio_api_key_here

# Composio Developer Personal Token
# Generate this in your Composio account settings
COMPOSIO_DEVELOPER_TOKEN=your_developer_personal_token_here

# AI Gateway API Key
# Your AI Gateway API key from Open-Connect
AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here

# Open-Connect API Key (optional)
# Your Open-Connect platform API key
OPEN_CONNECT_API_KEY=your_open_connect_api_key_here

# Model Gateway Keys (optional)
# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LiteLLM Master Key
LITELLM_MASTER_KEY=your_litellm_master_key_here

# OpenAI API Key (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# URLs
MCP_SERVER_URL=https://connect.composio.dev/mcp
OPEN_CONNECT_BASE_URL=https://open-connect.site
