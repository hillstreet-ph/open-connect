{
  "evaluation": {
    "source": {
      "name": "degraded_gateways",
      "display": "degraded_gateways"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
        "double_value": 0.0
      }
    },
    "empty_result_state": "OK",
    "notification": {
      "retrigger_seconds": 0,
      "notify_on_ok": true
    }
  },
  "schedule": {
    "quartz_cron_schedule": "0 0 7 * * ?",
    "timezone_id": "UTC"
  },
  "query_lines": [
    "SELECT COUNT(DISTINCT label) AS degraded_gateways",
    "FROM read_files('/Volumes/open_connect/supabase_migration/raw_files/ai_gateway_sweep_log.jsonl', format => 'json')",
    "WHERE degraded = true AND timestamp_utc >= current_timestamp() - INTERVAL 1 DAY"
  ]
}
