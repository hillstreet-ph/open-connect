{
  "name": "open-connect-agentkit",
  "version": "1.1.0",
  "commander": "open-connect",
  "skill": "skills/open-connect-agent/SKILL.md",
  "registry": "config/agent-collaboration.registry.json",
  "entrypoints": {
    "api": "/api/v1/collaborations/plan",
    "agents": "/api/v1/agents",
    "mcp": "https://open-connect.site/mcp"
  },
  "capabilities": [
    "agent.discovery",
    "task.plan",
    "task.route",
    "task.schedule",
    "workflow.resume",
    "memory.retrieve",
    "memory.record",
    "review.request",
    "approval.request",
    "audit.read"
  ],
  "clients": ["chatgpt", "claude", "grok", "mistral", "kimi", "manus", "hermes"],
  "credential_policy": "opaque-reference-only",
  "production_policy": "human-approval-required",
  "management_tools": {
    "read": ["get_admin_access", "get_owned_resource", "get_credential_management"],
    "write": [
      "create_resource",
      "update_resource",
      "upload_resource_content",
      "set_resource_publication"
    ],
    "required_write_scopes": ["resources:write", "control:write"],
    "required_write_role": "admin",
    "context": "personal",
    "credential_values": "authenticated-secrets-ui",
    "publication": "verified-resource-and-explicit-confirmation"
  }
}
